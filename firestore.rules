rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roleOf()   { return request.auth.token.role; }
    function isAdmin()  { return signedIn() && roleOf() in ['Admin', 'Super Admin']; }
    function isSuper()  { return signedIn() && roleOf() == 'Super Admin'; }

    // Users: own doc or admin may read. All writes via Cloud Functions only.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
    // Server-only secrets (password hashes, lockout counters)
    match /user_secrets/{id}   { allow read, write: if false; }
    match /login_attempts/{id} { allow read, write: if false; }

    // Password-reset tickets (doc id = userId)
    match /tickets/{ticketId} {
      allow read:   if signedIn() && (isAdmin() || ticketId == request.auth.uid);
      allow create: if signedIn() && ticketId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'Pending';
      allow update: if signedIn() && (isAdmin()
                    || (ticketId == request.auth.uid && request.resource.data.status == 'Pending'));
      allow delete: if isAdmin();
    }

    // Devices: Calculator is function-only. No client deletes (use purgeDevices function).
    match /devices/{deviceId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.project != 'Calculator';
      allow update: if signedIn() && resource.data.project != 'Calculator'
                                  && request.resource.data.project != 'Calculator';
      allow delete: if false;
    }

    // Audit logs: append-only, caller identity must match
    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.action != null
                    && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Settings & master configuration: any signed-in user reads, admins write
    match /settings/{id}                    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /roles/{id}                       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /projects/{id}                    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /stations_master/{id}             { allow read: if signedIn(); allow write: if isAdmin(); }
    match /station_checkpoints/{id}         { allow read: if signedIn(); allow write: if isAdmin(); }
    match /project_workflows/{id}           { allow read: if signedIn(); allow write: if isAdmin(); }
    match /project_workflows_versions/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }

    // Admin movements (written by admin tooling)
    match /admin_movements/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // BAAN inventory: operators consume/request parts, so signed-in users can create/update.
    match /baan_parts/{id}             { allow read: if signedIn(); allow create, update: if signedIn(); allow delete: if false; }
    match /baan_batches/{id}           { allow read: if signedIn(); allow create, update: if signedIn(); allow delete: if false; }
    match /baan_part_requests/{id}     { allow read: if signedIn(); allow create, update: if signedIn(); allow delete: if false; }
    match /baan_part_issuance/{id}     { allow read: if signedIn(); allow create, update: if signedIn(); allow delete: if false; }
    match /baan_bulk_uploads/{id}      { allow read: if signedIn(); allow create, update: if signedIn(); allow delete: if false; }
    match /baan_locations/{id}         { allow read: if signedIn(); allow create, update: if signedIn(); allow delete: if isAdmin(); }
    match /baan_inventory_movements/{id} { allow read: if signedIn(); allow create: if signedIn(); allow update, delete: if false; }
    match /baan_inward_logs/{id}         { allow read: if signedIn(); allow create: if signedIn(); allow update, delete: if false; }

    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}
